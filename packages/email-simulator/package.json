{
  "name": "@teamsuzie/email-simulator",
  "version": "0.1.0",
  "description": "An EmailClient for one persona's mailbox in the local email simulator, over its native REST API",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@teamsuzie/email-sync": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@teamsuzie/email": "workspace:*"
  }
}
