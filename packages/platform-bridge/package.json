{
  "name": "@teamsuzie/platform-bridge",
  "version": "0.1.0",
  "description": "Platform bridge for external agents — middleware, webhook handlers, and startup registration for the Team Suzie marketplace",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teamsuzie/agent-loop": "workspace:*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
