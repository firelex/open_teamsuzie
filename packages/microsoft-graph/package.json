{
  "name": "@teamsuzie/microsoft-graph",
  "version": "0.1.0",
  "description": "Microsoft 365 through Microsoft Graph as the signed-in user: sign-in (PKCE, public client), Outlook mail as an @teamsuzie/email client, calendar and Teams chats (read). Ported from Jeff Desk.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teamsuzie/email": "workspace:*",
    "@teamsuzie/email-sync": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
