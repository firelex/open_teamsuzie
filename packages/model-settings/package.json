{
  "name": "@teamsuzie/model-settings",
  "version": "0.1.0",
  "description": "Per-user overrides for the local-model agent registry — SQLite store + Express router. Pairs with @teamsuzie/agent-loop's validateLocalAgentUrl + resolveAgentTarget.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teamsuzie/agent-loop": "workspace:*",
    "@teamsuzie/db-sqlite": "workspace:*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
