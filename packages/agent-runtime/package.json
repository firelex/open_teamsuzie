{
  "name": "@teamsuzie/agent-runtime",
  "version": "0.1.0",
  "description": "Manifest-driven agent shell + Express boot + React app for SDK-based Team Suzie agents. The canonical runtime every starter and SuzieCode-generated app boots from.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./manifest": { "import": "./dist/manifest/index.js", "types": "./dist/manifest/index.d.ts" },
    "./server": { "import": "./dist/server/index.js", "types": "./dist/server/index.d.ts" },
    "./shell": { "import": "./dist/shell/AgentApp.js", "types": "./dist/shell/AgentApp.d.ts" },
    "./presets": { "import": "./dist/presets/index.js", "types": "./dist/presets/index.d.ts" },
    "./extensions": { "import": "./dist/extensions/index.js", "types": "./dist/extensions/index.d.ts" }
  },
  "files": ["dist", "bin"],
  "bin": {
    "agent-runtime-cleanup-port": "./bin/cleanup-port.sh"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teamsuzie/agent-loop": "workspace:*",
    "@teamsuzie/approvals": "workspace:*",
    "@teamsuzie/chats": "workspace:*",
    "@teamsuzie/db-sqlite": "workspace:*",
    "@teamsuzie/document-conversion": "workspace:*",
    "@teamsuzie/document-versions": "workspace:*",
    "@teamsuzie/docx": "workspace:*",
    "@teamsuzie/markdown-document": "workspace:*",
    "@teamsuzie/personas": "workspace:*",
    "@teamsuzie/platform-bridge": "workspace:*",
    "@teamsuzie/reviews": "workspace:*",
    "@teamsuzie/workflows": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.6.0",
    "express": "^5.1.0",
    "multer": "^2.0.1"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1",
    "@teamsuzie/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1",
    "@teamsuzie/ui": "workspace:*"
  }
}
