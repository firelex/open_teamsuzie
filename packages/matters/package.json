{
  "name": "@teamsuzie/matters",
  "version": "0.1.0",
  "description": "Composition layer that glues @teamsuzie/workspaces + @teamsuzie/sharing + @teamsuzie/chats + the agent-runtime file store into a 'matter' (case / deal / project) workspace. No new data tables — uses workspaces for matter rows and sharing for member rows.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teamsuzie/chats": "workspace:*",
    "@teamsuzie/document-versions": "workspace:*",
    "@teamsuzie/grid-review": "workspace:*",
    "@teamsuzie/sharing": "workspace:*",
    "@teamsuzie/workflows": "workspace:*",
    "@teamsuzie/workspaces": "workspace:*",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@teamsuzie/db-sqlite": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
