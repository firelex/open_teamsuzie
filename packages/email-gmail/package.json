{
  "name": "@teamsuzie/email-gmail",
  "version": "0.1.0",
  "description": "Gmail and Google Workspace for @teamsuzie/email: Google sign-in, token refresh, and an EmailClient over the Gmail API",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@teamsuzie/email": "workspace:*"
  }
}
