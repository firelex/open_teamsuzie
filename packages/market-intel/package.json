{
  "name": "@teamsuzie/market-intel",
  "version": "0.1.0",
  "description": "Provider-agnostic market/news intelligence search and watch-run persistence.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
