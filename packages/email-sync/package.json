{
  "name": "@teamsuzie/email-sync",
  "version": "0.1.0",
  "description": "Keeps a local copy of a mailbox up to date through a host-supplied store; sanitises email HTML and finds quoted history",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.0.18",
    "@teamsuzie/email-fixture": "workspace:*",
    "@types/sanitize-html": "^2.13.0"
  },
  "dependencies": {
    "@teamsuzie/email": "workspace:*",
    "sanitize-html": "^2.13.0"
  }
}
