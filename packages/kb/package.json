{
  "name": "@teamsuzie/kb",
  "version": "0.1.0",
  "description": "Lightweight RAG knowledge base — sqlite-vec storage + OpenAI-compatible embeddings + agent-loop tool",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teamsuzie/db-sqlite": "workspace:*",
    "@teamsuzie/document-conversion": "workspace:*",
    "sqlite-vec": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
