{
  "name": "@teamsuzie/document-conversion",
  "version": "0.1.0",
  "description": "Facade over mammoth (DOCX→md) and markitdown-agent (everything else→md, md→DOCX/PDF)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teamsuzie/agent-loop": "workspace:*",
    "@teamsuzie/markdown-document": "workspace:*",
    "@teamsuzie/pdf": "workspace:*",
    "adm-zip": "^0.5.17"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
