{
  "name": "@teamsuzie/conflicts",
  "version": "0.1.0",
  "description": "Parties register and conflict checks: parties with aliases linked to subjects (e.g. matters) by role, fuzzy name matching that ignores legal-form suffixes, and recorded checks with a decision.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teamsuzie/db-sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
