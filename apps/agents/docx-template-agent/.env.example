DOCX_TEMPLATE_AGENT_PORT=8082
DOCX_TEMPLATE_AGENT_OUTPUT_DIR=./output
DOCX_TEMPLATE_AGENT_TEMPLATES_DIR=./templates
DOCX_TEMPLATE_AGENT_PRECEDENTS_DIR=./precedents
DOCX_TEMPLATE_AGENT_PUBLIC_BASE_URL=http://localhost:8082

# LLM provider routing.
#   anthropic  → uses ANTHROPIC_API_KEY with the Anthropic SDK
#   openai     → uses OPENAI_API_KEY with the openai SDK
#   dashscope  → uses DASHSCOPE_API_KEY with the openai SDK pointed at Aliyun
# Default: dashscope if DASHSCOPE_API_KEY is set, else anthropic.
LLM_PROVIDER=

DEFAULT_LLM_MODEL=
DOCX_TEMPLATE_AGENT_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

ADMIN_SERVICE_URL=
