# LLM agent target — required for /api/chat to mount.
# When running under SuzieCode preview, these are injected automatically.
# When running standalone, set them yourself.
# AGENT_BASE_URL=
# AGENT_MODEL=
# AGENT_API_KEY=
# AGENT_EXTRA_BODY={"enable_thinking":false}

# Legal-research provider keys (only used when manifest.capabilities.legalResearch === true).
# All providers without keys are key-free or rate-limited public access.
# COURTLISTENER_TOKEN=
# LEGIFRANCE_CLIENT_ID=
# LEGIFRANCE_CLIENT_SECRET=
# JUDILIBRE_API_KEY=
# INDIAN_KANOON_API_KEY=
