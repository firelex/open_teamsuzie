{
  "schemaVersion": 1,
  "name": "Omnibus Agent",
  "description": "Manifest-driven SDK agent — configure via agent.json.",
  "theme": {
    "id": "default",
    "tokens": {
      "colorScheme": "light",
      "wordmarkStyle": "single",
      "bg": "#ffffff",
      "fg": "#0a0a0a",
      "panel": "#f5f5f5",
      "border": "#e5e5e5",
      "muted": "#737373",
      "primary": "#2563eb",
      "sidebarBg": "#0a0a0a",
      "sidebarFg": "#ffffff",
      "accentBar": { "color": "#2563eb", "width": "3px" },
      "fontSans": "system-ui, sans-serif",
      "fontMono": "ui-monospace, monospace",
      "fontDisplay": "system-ui, sans-serif"
    }
  },
  "modules": {
    "assistant": true, "history": true, "personas": true, "settings": true,
    "library": false,
    "matters": false, "admin": false, "reviews": false, "billing": false, "knowledgeBase": false
  },
  "components": {
    "chat": true, "toolActivity": true, "approvals": false,
    "knowledgeBase": false, "files": false, "citations": false, "workspace": false
  },
  "persona": {
    "id": "default", "name": "Assistant",
    "systemPrompt": "You are a helpful assistant. Answer clearly and use tools when they help."
  },
  "tools": []
}
