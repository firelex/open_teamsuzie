# ──────────────────────────────────────────────────────────────────────────
# starter-external-agent — environment template
#
# Copy to .env and fill in. Anything left commented uses the in-code default.
# ──────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────────
AGENT_PORT=16311
AGENT_PUBLIC_URL=http://localhost:16311
AGENT_ALLOWED_ORIGIN=http://localhost:17276
AGENT_TITLE=External Agent

# ── LLM (OpenAI-compatible endpoint — local llm-proxy, OpenRouter, etc.) ──
AGENT_NAME=Suzie
AGENT_DESCRIPTION=OpenAI-compatible assistant
AGENT_BASE_URL=http://localhost:4000
# AGENT_API_KEY=
AGENT_MODEL=openai/gpt-4.1-mini
# AGENT_EXTRA_BODY={"enable_thinking":false}
# AGENT_SYSTEM_PROMPT=You are an expert in widget triage. Be concise.

# ── Local dev auth bypass ─────────────────────────────────────────────────
# When true, every /api request gets a synthetic admin session — for hitting
# the agent's own React UI without a real auth layer in front. The starter
# refuses to boot if this is true and NODE_ENV=production.
AGENT_DEV_AUTH=true

# ── Platform bridge (suzie_monorepo / mothership) ─────────────────────────
# Leave the whole block unset for pure local dev with no marketplace integration.
# Set PLATFORM_URL + PLATFORM_TOKEN once your agent is reachable from the mothership.
#
# PLATFORM_TOKEN must equal the mothership's INTERNAL_SERVICE_KEY — that's the
# shared secret used for chat proxy + webhook calls in both directions.
#
# PLATFORM_URL=http://localhost:3008
# PLATFORM_TOKEN=
# PLATFORM_REG_TOKEN=
# PLATFORM_SLUG=my-agent
# PLATFORM_NAME=My Agent
# PLATFORM_DESCRIPTION=Short tagline that shows up in the marketplace catalog.
# PLATFORM_PROVIDER_NAME=Acme Corp
# PLATFORM_VERSION=0.1.0
# PLATFORM_FEATURES=sse_streaming

# ── Tools ────────────────────────────────────────────────────────────────
AGENT_TOOL_MAX_ITERATIONS=30
# Comma-separated host allow-list for the built-in http_request tool.
# AGENT_HTTP_ALLOWED_HOSTS=api.example.com,docs.example.com

# ── MCP servers (Claude Desktop config shape) ─────────────────────────────
# AGENT_MCP_CONFIG=./mcp.json

# ── Skills ────────────────────────────────────────────────────────────────
# AGENT_SKILLS_DIR=./skills
# AGENT_SKILL_CATALOG_URL=
# AGENT_SKILL_CATALOG_TOKEN=
# AGENT_SKILLS_ALLOW=skill-a,skill-b
# AGENT_SKILL_VAR_FOO=bar    # injected as {{FOO}} into skill markdown

# ── Personas ─────────────────────────────────────────────────────────────
# AGENT_PERSONAS_DIR=./personas

# ── Files / DB ────────────────────────────────────────────────────────────
# AGENT_MAX_UPLOAD_BYTES=26214400
# AGENT_DB_PATH=./data/agent.db

# ── Optional: vector DB + markitdown agent ────────────────────────────────
# AGENT_VECTOR_DB_BASE_URL=http://localhost:3006
# AGENT_VECTOR_DB_API_KEY=
# AGENT_MARKITDOWN_AGENT_BASE_URL=http://localhost:3004
