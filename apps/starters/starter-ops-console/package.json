{
  "name": "@teamsuzie/starter-ops-console",
  "version": "0.1.0",
  "description": "Internal-tool / ops-console starter with tables, auth guards, and selectively gated destructive actions",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "cd ../../../packages/shared-auth && npx tsc",
    "dev": "agent-runtime-cleanup-port 18311 && agent-runtime-cleanup-port 18276 && tsx watch src/bootstrap.ts & pnpm --filter @teamsuzie/starter-ops-console-client dev & wait",
    "build": "tsc",
    "start": "node dist/bootstrap.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teamsuzie/approvals": "workspace:*",
    "@teamsuzie/shared-auth": "workspace:*",
    "@teamsuzie/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-redis": "^8.0.1",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "dotenv": "^16.6.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@teamsuzie/agent-runtime": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
