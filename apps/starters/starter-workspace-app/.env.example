# starter-workspace-app — server config (all optional in dev).
# Auth is always OAuth/OIDC; point these at a reachable OIDC provider.

PORT=5211
WEB_ORIGIN=http://localhost:5273
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workspace_app
DEFAULT_TENANT_ID=default
# SESSION_SECRET=  # random per-process if unset (set in production)

OIDC_ISSUER_URL=http://localhost:3005
OIDC_CLIENT_ID=starter-workspace-app
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5211/api/auth/callback
# OIDC_RESOURCE — leave UNSET for a normal browser sign-in app. It only needs an
# opaque token + its own session/-me path, and apps/auth (no defaultResource)
# rejects an unregistered resource with `invalid_target`. Set to an absolute URI
# apps/auth registers as a resource server ONLY if you need a resource-bound JWT.
# OIDC_RESOURCE=
