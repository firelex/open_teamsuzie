# open_teamsuzie "lite" deploy profile
#
# Runs the platform with a single Postgres (with pgvector) instead of
# Milvus + Neo4j. Suitable for projects that don't need the scale or
# graph-traversal power of the full stack.
#
# Usage:
#   cp docker/lite.env.example .env
#   docker compose -f docker/docker-compose.yml up postgres redis
#   pnpm -F @teamsuzie/vector-db dev
#   pnpm -F @teamsuzie/graph-db  dev
#
# To run the full (heavy) stack instead:
#   docker compose -f docker/docker-compose.yml --profile heavy up

VECTOR_BACKEND=pgvector
GRAPH_BACKEND=pg

POSTGRES_URL=postgres://teamsuzie:teamsuzie@localhost:5432/teamsuzie
POSTGRES_PASSWORD=teamsuzie

# Vector dimensions must match your embedding model.
EMBEDDING_DIMENSIONS=1024

# Optional: separate tables per embedding profile.
EMBEDDING_PROFILE_ID=default
