# Postgres (auth, admin, shared-auth models)
POSTGRES_URI=postgres://teamsuzie:teamsuzie@localhost:5432/teamsuzie
POSTGRES_PASSWORD=teamsuzie

# Redis (BullMQ queues, usage tracking)
REDIS_URL=redis://localhost:6379

# Milvus (vector-db)
MILVUS_ADDRESS=localhost:19530

# Neo4j (graph-db)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=teamsuzie

# Session auth
COOKIE_SECRET=change-me-in-production-at-least-32-chars
CONFIG_ENCRYPTION_KEY=change-me-32-chars-aaaaaaaaaaaa

# Auth service (apps/platform/auth): see its README
# Who may sign up: closed (default; an admin creates accounts) | open | domains
AUTH_REGISTRATION=closed
# With AUTH_REGISTRATION=domains: the email domains that may sign up, comma-separated
AUTH_REGISTRATION_DOMAINS=
# Behind a reverse proxy: the number of proxies in front of the service (Express 'trust proxy')
AUTH_TRUST_PROXY=

# LLM providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Service URLs (for inter-service calls)
AUTH_URL=http://localhost:3005
LLM_PROXY_URL=http://localhost:4000
VECTOR_DB_URL=http://localhost:3006
GRAPH_DB_URL=http://localhost:3007
ADMIN_URL=http://localhost:3008
